labs(x = "Source", y = "H2O2 MIC (mM)",
title = "MIC distribution by origin") +
theme_bw(base_size = 12) +
theme(
axis.title   = element_text(face = "bold"),
axis.text.y  = element_text(face = "bold"),  # << make y-axis (origin) labels bold
plot.title   = element_text(face = "bold")
) +
coord_flip()
