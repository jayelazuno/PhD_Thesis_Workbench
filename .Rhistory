data <- read_csv(here("Data", "macrophage", "20251119_mac_kill_assay_data.csv"), skip = 3)
# install.packages("forcats")
library(here)
library(tidyverse)
library(ggdist)
library(forcats)
data <- read_csv(here("Data", "macrophage", "20251119_mac_kill_assay_data.csv"), skip = 3)
prepare_plot_data <- function(data, index_prefix) {
trial_cols <- names(data)[grepl(paste0("^", index_prefix, "_Trial"), names(data))]
if(length(trial_cols) == 0) return(NULL)
long_data <- data %>%
select(StrainID_Origin, all_of(trial_cols)) %>%
pivot_longer(cols = all_of(trial_cols), names_to = "Trial", values_to = "Value")
summary_data <- long_data %>%
group_by(StrainID_Origin) %>%
summarise(
Mean = mean(Value, na.rm = TRUE),
SEM = sd(Value, na.rm = TRUE) / sqrt(n()),
.groups = "drop"
)
desired_order <- c("CgLH", "CgBH", "CgBL", "CgRL", "ScLL")
long_data$StrainID_Origin <- factor(long_data$StrainID_Origin, levels = desired_order)
summary_data$StrainID_Origin <- factor(summary_data$StrainID_Origin, levels = desired_order)
list(long = long_data, summary = summary_data)
}
plot_index <- function(long_data, summary_data, title) {
set.seed(42)
ggplot(summary_data, aes(x = StrainID_Origin, y = Mean)) +
geom_bar(stat = "identity", fill = "white", color = "black", width = 0.6) +
geom_errorbar(aes(ymin = Mean - SEM, ymax = Mean + SEM), width = 0.2) +
geom_jitter(data = long_data, aes(y = Value), width = 0.1, shape = 21, size = 2) +
theme_bw() +
labs(title = title, x = "Strain", y = "Index Value") +
theme(axis.text.x = element_text(angle = 45, hjust = 1, face = "bold"),
axis.text.y = element_text(face = "bold"),
axis.title = element_text(face = "bold"))
}
# Generate and store plots
survival_plot <- if(!is.null(prepare_plot_data(data, "Survival_Index"))) {
survival_data <- prepare_plot_data(data, "Survival_Index")
plot_index(survival_data$long, survival_data$summary, "Survival Index")
}
phagocytosis_plot <- if(!is.null(prepare_plot_data(data, "Phagocytosis_Index"))) {
phagocytosis_data <- prepare_plot_data(data, "Phagocytosis_Index")
plot_index(phagocytosis_data$long, phagocytosis_data$summary, "Phagocytosis Index")
}
avoidance_plot <- if(!is.null(prepare_plot_data(data, "Avoidance_Index"))) {
avoidance_data <- prepare_plot_data(data, "Avoidance_Index")
plot_index(avoidance_data$long, avoidance_data$summary, "Avoidance Index")
}
## you can call each plot by its name
survival_plot
phagocytosis_plot
avoidance_plot
